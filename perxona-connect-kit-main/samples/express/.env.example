# Perxona Connect Kit — Environment Variables
# ─────────────────────────────────────────────
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values (register via the Connect signup & confirm-signup API — see README)
# 3. Start the server: npm start

# ── Required ───────────────────────────────────────────────────────────────

# Perxona API base URL — region-specific; use https://console.perxona.ai/asia or your region's URL
# Example: https://console.perxona.ai/eu  or  https://console.perxona.ai/asia
PERXONA_API_BASE_URL=https://console.perxona.ai/asia

# Perxona Connect service credentials — the server logs in with these on
# your behalf (no browser sign-in). Please create your own account 
# using the Sign Up API. Every visitor to this sample shares this one Connect identity.
PERXONA_CONNECT_EMAIL=
PERXONA_CONNECT_PASSWORD=

# ── Optional ───────────────────────────────────────────────────────────────

# Server port (default: 8083)
PORT=8083

# Perxona presenter engine URL (CDN). Defaults to the production engine.
# Override only if your Perxona contact provides a specific URL.
PRESENTER_URL=https://cdn.perxona.ai/asia/prod/latest/widget/entry/presenter.js

# ── Starter demo defaults ──────────────────────────────────────────────────
# These IDs are used by /demos/starter/ and can be replaced with resources
# available in your Connect account. The server reports them via /api/config.
DEMO_DEFAULT_AVATAR_ID=01KM2H4H12MZ66BXQAYC55C4CT
DEMO_DEFAULT_SCENE_ID=01KQBD9EBX9VQ32JB68WPVWVYK
DEMO_DEFAULT_VOICE_ID=01KY14FJX8QJMSR0NCH515PPH8
DEMO_DEFAULT_MOTION_ID=01KRW97VSEA5G49W2YXWGV8JRV

# ── Fixed target ─────────────────────────────────────────────────────────
# This is what YOUR project's config should look like once you've picked an
# avatar/scene/voice — no dropdown UI needed. Set avatar + scene to lock the
# target and hide the catalog picker. Voice is optional: leave blank for
# BYO-TTS + presentWithAudio().
# Find IDs via the catalog picker in /demos/basic/, or call the server's
# GET /api/avatars, /api/scenes, /api/voices endpoints directly.
DEMO_FIXED_AVATAR_ID=
DEMO_FIXED_SCENE_ID=
DEMO_FIXED_VOICE_ID=

# ── LLM chat integration (Option C — disabled by default) ──────────────────
# Leave LLM_API_KEY blank to keep chat disabled (safe default, no key required)
# Fill in to enable the chat panel → avatar answers questions
LLM_API_KEY=
# Provider protocol: openai (Chat Completions) or anthropic (Claude Messages API)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Local & free (Ollama): LLM_BASE_URL=http://localhost:11434/v1  (no key needed)
# Claude: LLM_PROVIDER=anthropic, LLM_BASE_URL=https://api.anthropic.com, LLM_MODEL=claude-sonnet-4-20250514
